DATABASE_URL=postgresql://username:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_INITIAL_PASSWORD=
CRON_SECRET=
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=

# Vercel Blob storage — durable file uploads (tender PDFs, etc.).
# On Vercel: create a Blob store and connect it to the project; Vercel injects this automatically.
# Without it, uploads fall back to local disk (dev only).
BLOB_READ_WRITE_TOKEN=
